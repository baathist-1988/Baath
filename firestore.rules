rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidFlair(flair) {
      return flair in ['Guardian', 'Tinky Winky', 'Dipsy', 'Laa-Laa', 'Po', 'Newborn'];
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 30 &&
             data.tubbyFlair is string && isValidFlair(data.tubbyFlair) &&
             data.statusMessage is string && data.statusMessage.size() <= 80 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFanMember(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.groupId == 'slendytubbies-onlyfans' &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 30 &&
             data.tubbyFlair is string && isValidFlair(data.tubbyFlair) &&
             data.statusMessage is string && data.statusMessage.size() <= 80 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidChannel(data) {
      return data.groupId == 'slendytubbies-onlyfans' &&
             data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 32 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 40 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 140 &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 100 &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             (!('lastMessageText' in data) || data.lastMessageText == null || (data.lastMessageText is string && data.lastMessageText.size() <= 200)) &&
             (!('lastMessageSender' in data) || data.lastMessageSender == null || (data.lastMessageSender is string && data.lastMessageSender.size() <= 30)) &&
             (!('lastMessageAt' in data) || data.lastMessageAt == null || (data.lastMessageAt is timestamp && data.lastMessageAt <= request.time)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMessage(data, expectedChannelId) {
      return data.channelId == expectedChannelId &&
             data.groupId == 'slendytubbies-onlyfans' &&
             data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 30 &&
             data.senderFlair is string && isValidFlair(data.senderFlair) &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             (!('replyToId' in data) || data.replyToId == null || (data.replyToId is string && data.replyToId.size() <= 128)) &&
             (!('replyToSender' in data) || data.replyToSender == null || (data.replyToSender is string && data.replyToSender.size() <= 30)) &&
             (!('replyToText' in data) || data.replyToText == null || (data.replyToText is string && data.replyToText.size() <= 120)) &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // 1. Private User Profile (strict owner-only access)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'tubbyFlair', 'statusMessage', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'tubbyFlair', 'statusMessage', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'tubbyFlair', 'statusMessage', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 2. Public Non-PII Fan Directory Members
    match /fan_members/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && existing().groupId == 'slendytubbies-onlyfans';

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'groupId', 'displayName', 'tubbyFlair', 'statusMessage', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'groupId', 'displayName', 'tubbyFlair', 'statusMessage', 'createdAt', 'updatedAt']) &&
                       isValidFanMember(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidFanMember(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().groupId == existing().groupId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'tubbyFlair', 'statusMessage', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
    }

    // 3. Topic Channels
    match /channels/{channelId} {
      allow get: if isSignedIn() && isValidId(channelId);
      allow list: if isSignedIn() && existing().groupId == 'slendytubbies-onlyfans';

      allow create: if isSignedIn() &&
                       isValidId(channelId) &&
                       incoming().createdBy == request.auth.uid &&
                       incoming().keys().hasAll(['groupId', 'slug', 'name', 'description', 'sortOrder', 'createdBy', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['groupId', 'slug', 'name', 'description', 'sortOrder', 'createdBy', 'lastMessageText', 'lastMessageSender', 'lastMessageAt', 'createdAt', 'updatedAt']) &&
                       isValidChannel(incoming());

      allow update: if isSignedIn() &&
                       isValidId(channelId) &&
                       isValidChannel(incoming()) &&
                       incoming().createdBy == existing().createdBy &&
                       incoming().groupId == existing().groupId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['lastMessageText', 'lastMessageSender', 'lastMessageAt', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(channelId) && existing().createdBy == request.auth.uid;

      // 4. Channel Messages
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(channelId) && isValidId(messageId);
        allow list: if isSignedIn() && existing().channelId == channelId;

        allow create: if isSignedIn() &&
                         isValidId(channelId) &&
                         isValidId(messageId) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().keys().hasAll(['channelId', 'groupId', 'senderId', 'senderName', 'senderFlair', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['channelId', 'groupId', 'senderId', 'senderName', 'senderFlair', 'text', 'replyToId', 'replyToSender', 'replyToText', 'createdAt']) &&
                         isValidMessage(incoming(), channelId) &&
                         exists(/databases/$(database)/documents/channels/$(channelId));

        allow update: if false;

        allow delete: if isSignedIn() &&
                         isValidId(channelId) &&
                         isValidId(messageId) &&
                         existing().senderId == request.auth.uid;
      }
    }
  }
}
